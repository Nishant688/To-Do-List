# ==============================================================================
# TASKFLOW - PRODUCTION ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================
# Copy this file to .env or add these variables directly in the Vercel Dashboard
# (Settings -> Environment Variables)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB Atlas)
# ------------------------------------------------------------------------------
# Set this to your MongoDB Atlas connection string:
# Format: mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/<dbname>?retryWrites=true&w=majority
# (The backend supports either MONGODB_URI or MONGO_URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/taskflow?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/taskflow?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# Secret key used to sign and verify JWT authentication tokens.
# Use a strong, random 32+ character string in production.
# Example command to generate: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_for_production_replace_this
JWT_EXPIRE=30d

# ------------------------------------------------------------------------------
# 3. CORS & CLIENT CONFIGURATION
# ------------------------------------------------------------------------------
# The production URL of your frontend application on Vercel:
# (Requests from *.vercel.app are also automatically permitted)
CLIENT_URL=https://your-taskflow-app.vercel.app

# ------------------------------------------------------------------------------
# 4. SERVER & ENVIRONMENT MODE
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# ------------------------------------------------------------------------------
# 5. FRONTEND API CONFIGURATION (Vite)
# ------------------------------------------------------------------------------
# For Unified Monorepo Vercel Deployment (Same Domain):
VITE_API_URL=/api
# For Separate Backend Deployment (e.g. backend deployed to separate Vercel URL):
# VITE_API_URL=https://your-taskflow-backend.vercel.app/api
